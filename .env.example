# Copie para .env.local e preencha. Nunca versione o .env.local.

# Conexão Postgres (Neon). Use sslmode=verify-full.
DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=verify-full&channel_binding=require"

# Segredo do Better Auth (32+ bytes aleatórios):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# URL pública do site
BETTER_AUTH_URL="http://localhost:3000"

# E-mail (opcional em desenvolvimento: sem chave, os links aparecem no terminal)
RESEND_API_KEY=""
EMAIL_FROM="Torcedor Santastico <nao-responda@seu-dominio.com>"

# API Santos FC (projeto próprio, pasta API-SANTOS): fonte dos jogos
SANTOS_API_URL="http://localhost:8000"
SANTOS_API_KEY=""

# Protege a rota de sincronização. Gere um valor aleatório.
CRON_SECRET=""

# API Santos (projeto API-SANTOS, roda à parte na porta 8000). Usada só no servidor.
SANTOS_API_URL="http://localhost:8000"
# Mesmo valor de API_KEY no .env da API-SANTOS
SANTOS_API_KEY=""
